{
	"name": "joinly-api",
	"version": "0.1.0",
	"description": "Joinly backend API",
	"type": "module",
	"engines": {
		"node": ">=22.0.0"
	},
	"scripts": {
		"dev": "tsx watch src/index.ts",
		"build": "tsc",
		"start": "node dist/index.js",
		"lint": "biome check src/",
		"lint:fix": "biome check --write src/",
		"format": "biome format --write src/",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:api": "newman run tests/auth.postman_collection.json"
	},
	"dependencies": {
		"bcryptjs": "^3.0.3",
		"better-sqlite3": "^12.6.2",
		"cors": "^2.8.5",
		"dotenv": "^16.4.7",
		"express": "^5.0.1",
		"express-rate-limit": "^8.2.1",
		"helmet": "^8.0.0",
		"jsonwebtoken": "^9.0.3",
		"npm": "^11.9.0",
		"uuid": "^13.0.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.2.4",
		"@types/bcryptjs": "^2.4.6",
		"@types/better-sqlite3": "^7.6.13",
		"@types/cors": "^2.8.17",
		"@types/express": "^5.0.0",
		"@types/jsonwebtoken": "^9.0.10",
		"@types/node": "^22.10.7",
		"newman": "^6.2.2",
		"tsx": "^4.19.2",
		"typescript": "^5.7.3",
		"vitest": "^3.0.5"
	}
}
