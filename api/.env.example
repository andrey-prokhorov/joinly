# Joinly API - Environment Variables
# Kopiera denna fil till .env och fyll i värden

# Server
NODE_ENV=development
PORT=3001

# JWT (MÅSTE ändras i produktion!)
JWT_SECRET=your-super-secret-key-change-in-production-min-32-chars
JWT_EXPIRES_IN=24h

# Databas (framtida)
# DATABASE_PATH=./db/joinly.db

# Seed-data (bara development/test, ALDRIG i produktion)
# Lösenordskrav: 8+ tecken, stor bokstav, liten bokstav, siffra, specialtecken
SEED_TESTUSER_1_PASSWORD=change-me-in-env
SEED_TESTUSER_2_PASSWORD=change-me-in-env
SEED_ADMIN_1_PASSWORD=change-me-in-env

# ACL (åtkomstkontroll)
# Standard är PÅ även om denna rad saknas.
# Sätt bara ACL_ENABLED=false tillfälligt vid felsökning.
ACL_ENABLED=true

# Rate limiting
# Standard är PÅ i kod, men false här för lokal utveckling/test.
# I produktion: RATE_LIMIT_ENABLED=true
RATE_LIMIT_ENABLED=false

# Loggning
# LOG_PRETTY=true ger färgad, läsbar terminal-output (kräver pino-pretty i devDependencies)
# Sätt aldrig true i produktion - där vill vi ren JSON för log-aggregatorer
LOG_PRETTY=true
# LOG_LEVEL=debug
