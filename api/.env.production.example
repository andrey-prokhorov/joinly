# Joinly API - Production Environment Variables (Railway)
# Use these as reference when setting environment variables in Railway dashboard
# DO NOT commit this file with actual values!

# Server Configuration
NODE_ENV=production
PORT=3001

# JWT Configuration (CRITICAL: Generate secure random key!)
# Use: openssl rand -base64 32
# Or: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_SECRET=REPLACE_WITH_SECURE_RANDOM_KEY_MIN_32_CHARS
JWT_EXPIRES_IN=2h

# Security Settings
RATE_LIMIT_ENABLED=true
ACL_ENABLED=true

# Seed User Passwords (Production)
# Requirements: 8+ chars, uppercase, lowercase, number, special char
# Generate secure passwords and store them safely
SEED_TESTUSER_1_PASSWORD=REPLACE_WITH_SECURE_PASSWORD
SEED_TESTUSER_2_PASSWORD=REPLACE_WITH_SECURE_PASSWORD
SEED_ADMIN_1_PASSWORD=REPLACE_WITH_SECURE_PASSWORD

# Database Configuration (Future)
# DATABASE_URL=postgresql://... (for future PostgreSQL migration)

# Additional Production Settings
# LOG_LEVEL=info
# MAX_REQUEST_SIZE=10mb
# CORS_ORIGIN=https://your-frontend-domain.railway.app