							"    const json = pm.response.json();",
							"    pm.expect(json.success).to.eql(true);",
							"});",
							"",
							"// Test: Response innehåller skapade eventet",
							"pm.test('Response has created event', function () {",
							"    const json = pm.response.json();",
							"    pm.expect(json.event).to.be.an('object');",
							"    pm.expect(json.event.id).to.be.a('string');",
							"    pm.expect(json.event.title).to.eql('Newman Test Event Title');",
							"    pm.expect(json.event.description).to.eql('Newman Test Event Description');",
							"    pm.expect(json.event.city).to.eql('Stockholm');",
							"    ",
							"    // Spara event ID för uppdatering och borttagning",
							"    pm.collectionVariables.set('testEventId', json.event.id);",
							"});",
