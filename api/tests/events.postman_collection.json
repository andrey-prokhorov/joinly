							"    pm.expect([200, 404]).to.include(pm.response.code);",
							"});",
							"",
							"// Test: Om 200, kontrollera att response har event",
							"pm.test('If 200, response has event data', function () {",
							"    if (pm.response.code === 200) {",
							"        const json = pm.response.json();",
							"        pm.expect(json.success).to.eql(true);",
							"        pm.expect(json.event).to.be.an('object');",
							"    }",
							"});",
							"",
							"// Test: Om 404, kontrollera felmeddelande",
							"pm.test('If 404, response has error message', function () {",
