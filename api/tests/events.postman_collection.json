{
	"info": {
		"name": "Joinly API - Events Tests",
		"description": "Events CRUD tests for Joinly API. Registers a unique test user for auth.\n\n## Events Read Tests (require auth: role user or admin)\n1. Events - Get all (with token)\n2. Events - Get all (without token - expects 401 Unauthorized)\n3. Events - Get by ID (with token)\n4. Events - Get by ID (without token - expects 401 Unauthorized)\n5. Events - Filter search (with token)\n6. Events - Filter search (without token - expects 401 Unauthorized)\n\n## Events CRUD Tests (require auth + ACL)\n7. Events - Create event (with token)\n8. Events - Create event (without token)\n9. Events - Create event with missing fields\n10. Events - Create event with invalid dates\n11. Events - Update event (with token)\n12. Events - Update event (without token)\n13. Events - Update non-existent event\n14. Events - Update with invalid dates\n15. Events - Delete event (with token)\n16. Events - Delete event (without token)\n17. Events - Delete non-existent event\n\n## Chat Tests (require auth + registration)\n18. Chat - Get messages (registered with token)\n19. Chat - Get messages (without token)\n20. Chat - Get messages for non-existent event\n21. Chat - Post message (registered with token)\n22. Chat - Post message (without token)\n23. Chat - Post message with empty message\n24. Chat - Post message for non-existent event\n\n## Usage\n```bash\nnewman run tests/events.postman_collection.json --env-var \"baseUrl=http://localhost:3001\"\n```",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:3001",
			"type": "string"
		},
		{
			"key": "authToken",
			"value": "",
			"type": "string",
			"description": "Auth token - set this manually or run auth collection first"
		},
		{
			"key": "testEventId",
			"value": "",
			"type": "string"
		},
		{
			"key": "registerEmail",
			"value": "",
			"type": "string"
		},
		{
			"key": "testChatMessageId",
			"value": "",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "Setup - Register for Events Tests",
			"event": [
				{
					"listen": "prerequest",
					"script": {
						"exec": [
							"// Generera unik email för denna testkörning",
							"const uniqueEmail = 'newman-events-' + Date.now() + '@test.com';",
							"pm.collectionVariables.set('registerEmail', uniqueEmail);"
						],
						"type": "text/javascript"
					}
				},
				{
					"listen": "test",
					"script": {
						"exec": [
							"// Test: Register lyckas med 201",
							"pm.test('Status code is 201', function () {",
							"    pm.response.to.have.status(201);",
							"});",
							"",
							"// Test: Response innehåller token",
							"pm.test('Response has token', function () {",
							"    const json = pm.response.json();",
							"    pm.expect(json.token).to.be.a('string');",
							"    pm.expect(json.token.length).to.be.greaterThan(0);",
							"    ",
							"    // Spara token för nästa test",
							"    pm.collectionVariables.set('authToken', json.token);",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"name\": \"Newman Testare\",\n    \"email\": \"{{registerEmail}}\",\n    \"password\": \"Test123!\"\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/api/auth/register",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"auth",
						"register"
					]
				}
			}
		},
