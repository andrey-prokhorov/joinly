{
	"info": {
		"name": "Joinly API - Health Check",
		"description": "Health check endpoint for Joinly API.\n\n## Health Check\n1. Health check - Verify API is running\n\n## Usage\n```bash\nnewman run tests/health.postman_collection.json --env-var \"baseUrl=http://localhost:3001\"\n```",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:3001",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "1. Health Check",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"// Test: API svarar med 200",
							"pm.test('Status code is 200', function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"// Test: Response innehåller status OK",
							"pm.test('Response has status ok', function () {",
							"    const json = pm.response.json();",
							"    pm.expect(json.status).to.eql('ok');",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/api/health",
					"host": ["{{baseUrl}}"],
					"path": ["api", "health"]
				}
			}
		}
	]
}