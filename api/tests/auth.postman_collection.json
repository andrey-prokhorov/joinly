							"pm.test('Status code is 409', function () {",
							"    pm.response.to.have.status(409);",
							"});",
							"",
							"// Test: Felmeddelande om att email redan finns",
							"pm.test('Response says email already registered', function () {",
							"    const json = pm.response.json();",
							"    pm.expect(json.message).to.include('redan registrerad');",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
