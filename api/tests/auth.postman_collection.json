{
	"info": {
		"name": "Joinly API - Auth & Events Tests",
		"description": "Tester för autentisering och events i Joinly API.\n\n## Register Tester\n1. Health check\n2. Register OK (ny användare)\n3. Register - Dubblett-email\n4. Register - Dåligt lösenord\n5. Register - Saknade fält\n\n## Auth Tester\n6. Login OK\n7. Login fel lösenord\n8. Login saknar fält\n9. Me utan token\n10. Me med token\n11. Login icke-existerande email\n12. Login ogiltigt email-format\n13. Me malformad Authorization header\n\n## Events Tester\n14. Events - Get all (with token)\n15. Events - Get all (without token)\n16. Events - Get by ID (with token)\n17. Events - Get by ID (without token)\n18. Events - Filter search (with token)\n19. Events - Filter search (without token)\n\n## Köra med Newman\n```bash\nnewman run auth.postman_collection.json --env-var \"baseUrl=http://localhost:3001\"\n```",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:3001",
			"type": "string"
		},
		{
			"key": "authToken",
			"value": "",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "1. Health Check",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"// Test: API svarar med 200",
							"pm.test('Status code is 200', function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"// Test: Response innehåller status OK",
							"pm.test('Response has status ok', function () {",
							"    const json = pm.response.json();",
							"    pm.expect(json.status).to.eql('ok');",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/api/health",
					"host": ["{{baseUrl}}"],
					"path": ["api", "health"]
				}
			}
		},
		{
			"name": "2. Register OK",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"// Test: Registrering lyckas med 201",
							"pm.test('Status code is 201', function () {",
							"    pm.response.to.have.status(201);",
							"});",
							"",
							"// Test: Response innehåller token (auto-inloggning)",
							"pm.test('Response has token', function () {",
							"    const json = pm.response.json();",
							"    pm.expect(json.token).to.be.a('string');",
							"    pm.expect(json.token.length).to.be.greaterThan(0);",
							"});",
							"",
							"// Test: Response innehåller user-info",
							"pm.test('Response has user info', function () {",
							"    const json = pm.response.json();",
							"    pm.expect(json.user).to.have.property('id');",
							"    pm.expect(json.user).to.have.property('email');",
							"    pm.expect(json.user.email).to.eql('newman@test.com');",
							"    pm.expect(json.user).to.have.property('name');",
							"    pm.expect(json.user.name).to.eql('Newman Testare');",
							"    pm.expect(json.user.role).to.eql('user');",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
