							"        pm.expect(json.event).to.be.an('object');",
							"    }",
							"});",
							"",
							"// Test: Om 404, kontrollera felmeddelande",
							"pm.test('If 404, response has error message', function () {",
							"    if (pm.response.code === 404) {",
							"        const json = pm.response.json();",
							"        pm.expect(json.success).to.eql(false);",
