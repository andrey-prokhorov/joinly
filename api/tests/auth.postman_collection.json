							"    pm.expect(json.events).to.be.an('array');",
							"    pm.expect(json.count).to.be.a('number');",
							"    pm.expect(json.filters).to.be.an('object');",
							"    pm.expect(json.filters.city).to.eql('Stockholm');",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
