{
	"info": {
		"name": "Joinly API - Auth Tests",
		"description": "Tester för autentisering i Joinly API.\n\n## Tester\n1. Health check\n2. Login OK\n3. Login fel lösenord\n4. Login saknar fält\n5. Me utan token\n6. Me med token\n\n## Köra med Newman\n```bash\nnewman run auth.postman_collection.json --env-var \"baseUrl=http://localhost:3001\"\n```",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:3001",
			"type": "string"
		},
		{
			"key": "authToken",
			"value": "",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "1. Health Check",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"// Test: API svarar med 200",
							"pm.test('Status code is 200', function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"// Test: Response innehåller status OK",
							"pm.test('Response has status ok', function () {",
							"    const json = pm.response.json();",
							"    pm.expect(json.status).to.eql('ok');",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/api/health",
					"host": ["{{baseUrl}}"],
					"path": ["api", "health"]
				}
			}
		},
		{
			"name": "2. Login OK",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"// Test: Login lyckas med 200",
							"pm.test('Status code is 200', function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"// Test: Response innehåller token",
							"pm.test('Response has token', function () {",
							"    const json = pm.response.json();",
							"    pm.expect(json.token).to.be.a('string');",
							"    pm.expect(json.token.length).to.be.greaterThan(0);",
							"    ",
							"    // Spara token för nästa test",
							"    pm.collectionVariables.set('authToken', json.token);",
							"});",
							"",
							"// Test: Response innehåller user-info",
							"pm.test('Response has user info', function () {",
							"    const json = pm.response.json();",
							"    pm.expect(json.user).to.have.property('id');",
							"    pm.expect(json.user).to.have.property('email');",
							"    pm.expect(json.user.email).to.eql('test@example.com');",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"email\": \"test@example.com\",\n    \"password\": \"Test123!\"\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/api/auth/login",
					"host": ["{{baseUrl}}"],
					"path": ["api", "auth", "login"]
				}
			}
		},
		{
			"name": "3. Login - Fel lösenord",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"// Test: Fel lösenord ger 401",
							"pm.test('Status code is 401', function () {",
							"    pm.response.to.have.status(401);",
							"});",
							"",
							"// Test: Response innehåller felmeddelande",
							"pm.test('Response has error message', function () {",
							"    const json = pm.response.json();",
							"    pm.expect(json.message).to.include('Ogiltig');",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"email\": \"test@example.com\",\n    \"password\": \"FelLösenord123!\"\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/api/auth/login",
					"host": ["{{baseUrl}}"],
					"path": ["api", "auth", "login"]
				}
			}
		},
		{
			"name": "4. Login - Saknar fält",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"// Test: Saknade fält ger 400",
							"pm.test('Status code is 400', function () {",
							"    pm.response.to.have.status(400);",
							"});",
							"",
							"// Test: Response innehåller felmeddelande",
							"pm.test('Response has error message', function () {",
							"    const json = pm.response.json();",
							"    pm.expect(json.message).to.be.a('string');",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{}"
				},
				"url": {
					"raw": "{{baseUrl}}/api/auth/login",
					"host": ["{{baseUrl}}"],
					"path": ["api", "auth", "login"]
				}
			}
		},
		{
			"name": "5. Me - Utan token",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"// Test: Utan token ger 401",
							"pm.test('Status code is 401', function () {",
							"    pm.response.to.have.status(401);",
							"});",
							"",
							"// Test: Response säger att token saknas",
							"pm.test('Response says no token', function () {",
							"    const json = pm.response.json();",
							"    pm.expect(json.message).to.include('token');",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/api/auth/me",
					"host": ["{{baseUrl}}"],
					"path": ["api", "auth", "me"]
				}
			}
		},
		{
			"name": "6. Me - Med token",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"// Test: Med giltig token ger 200",
							"pm.test('Status code is 200', function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"// Test: Response innehåller user-info",
							"pm.test('Response has user info', function () {",
							"    const json = pm.response.json();",
							"    pm.expect(json.user).to.have.property('userId');",
							"    pm.expect(json.user).to.have.property('email');",
							"    pm.expect(json.user.email).to.eql('test@example.com');",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer {{authToken}}"
					}
				],
				"url": {
					"raw": "{{baseUrl}}/api/auth/me",
					"host": ["{{baseUrl}}"],
					"path": ["api", "auth", "me"]
				}
			}
		}
	]
}
