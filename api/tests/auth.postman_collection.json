{
	"info": {
		"name": "Joinly API - Authentication Tests",
		"description": "Authentication tests for Joinly API.\n\n## Register Tests\n1. Register OK (ny användare)\n2. Register - Dubblett-email\n3. Register - Dåligt lösenord\n4. Register - Saknade fält\n\n## Login Tests\n5. Login OK\n6. Login fel lösenord\n7. Login saknar fält\n8. Login icke-existerande email\n9. Login ogiltigt email-format\n\n## Profile Tests\n10. Me utan token\n11. Me med token\n12. Me malformad Authorization header\n\n## Logout Tests\n13. Logout OK (invaliderar token)\n14. Me efter logout (ska ge 401)\n15. Logout utan token\n\n## Usage\n```bash\nnewman run tests/auth.postman_collection.json --env-var \"baseUrl=http://localhost:3001\"\n```",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:3001",
			"type": "string"
		},
		{
			"key": "authToken",
			"value": "",
			"type": "string"
		},
		{
			"key": "registerEmail",
			"value": "",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "1. Register OK",
			"event": [
				{
					"listen": "prerequest",
					"script": {
						"exec": [
							"// Generera unik email med timestamp så testet inte krockar med tidigare körningar",
							"const uniqueEmail = 'newman+' + Date.now() + '@test.com';",
							"pm.collectionVariables.set('registerEmail', uniqueEmail);"
						],
						"type": "text/javascript"
					}
				},
				{
					"listen": "test",
					"script": {
						"exec": [
							"// Test: Registrering lyckas med 201",
							"pm.test('Status code is 201', function () {",
							"    pm.response.to.have.status(201);",
							"});",
							"",
							"// Test: Response innehåller token (auto-inloggning)",
							"pm.test('Response has token', function () {",
							"    const json = pm.response.json();",
							"    pm.expect(json.token).to.be.a('string');",
							"    pm.expect(json.token.length).to.be.greaterThan(0);",
							"});",
							"",
							"// Test: Response innehåller user-info",
							"pm.test('Response has user info', function () {",
							"    const json = pm.response.json();",
							"    const expectedEmail = pm.collectionVariables.get('registerEmail');",
							"    pm.expect(json.user).to.have.property('id');",
							"    pm.expect(json.user).to.have.property('email');",
							"    pm.expect(json.user.email).to.eql(expectedEmail);",
							"    pm.expect(json.user).to.have.property('name');",
							"    pm.expect(json.user.name).to.eql('Newman Testare');",
							"    pm.expect(json.user.role).to.eql('user');",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"name\": \"Newman Testare\",\n    \"email\": \"{{registerEmail}}\",\n    \"password\": \"Test123!\"\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/api/auth/register",
					"host": ["{{baseUrl}}"],
					"path": ["api", "auth", "register"]
				}
			}
		},
		{
			"name": "2. Register - Dubblett-email",
			"event": [
				{
					"listen": "test",
